---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found | EloraOS" description="This page doesn't exist. Head back to meet Elora, the private AI companion for your PC." noindex>
  <section class="bg-cosmos flex min-h-[80vh] flex-col items-center justify-center px-4 pt-28 pb-20 text-center sm:px-6">
    <span class="eyebrow text-error">Error 404 · signal lost</span>
    <h1 class="mt-6 font-display text-[clamp(2.4rem,1.4rem+4vw,4.5rem)] font-bold leading-tight text-primary">Nothing on this frequency.</h1>
    <p class="mt-5 max-w-md text-body-lg text-on-surface-variant">The page you were looking for isn't here. Elora is, though.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary"><Icon name="sparkles" size={18} />Back to Elora</a>
      <a href="/faq/" class="btn-ghost">Read the FAQ</a>
    </div>
  </section>
</Base>
