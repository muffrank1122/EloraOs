---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { FAQS } from '../data/faq';

const title = 'Elora FAQ: The Local AI Companion for Windows';
const description =
  'Does Elora work without the cloud? What GPU does she need? Does she speak Roman Urdu? Answers on privacy, actions, your data and early access.';
const path = '/faq/';

const mainEntity = FAQS.map((f) => ({
  '@type': 'Question',
  name: f.q,
  acceptedAnswer: { '@type': 'Answer', text: f.a },
}));
---

<Base title={`${title} | EloraOS`} description={description} pageType="FAQPage" pageProps={{ mainEntity }} breadcrumbs={[{ name: 'FAQ', path }]}>
  <PageHeader
    eyebrow="Frequently asked"
    title="Questions about Elora"
    lead="What she runs on, what stays private, which languages she speaks, and when you can meet her."
    crumbs={[{ name: 'FAQ', path }]}
  />

  <div class="bg-surface px-4 pb-24 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <FaqList items={FAQS} openFirst headingLevel="h2" />
    </div>
  </div>

  <CtaBand />
</Base>
