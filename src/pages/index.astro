---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import CognitiveLoop from '../components/home/CognitiveLoop.astro';
import EarlyAccess from '../components/home/EarlyAccess.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { FAQS } from '../data/faq';

const capabilities = [
  { icon: 'mic', tag: 'Conversation', title: 'Talk the way you think.', body: 'English, Roman Urdu, or a little of both. Hold the mic to talk, hear streamed replies, and interrupt when you have something new to say.', example: '“Yaad dilana kal subah 9 baje.”' },
  { icon: 'brain', tag: 'Context & memory', title: 'Pick up the thread.', body: 'Local screen context, a searchable timeline and dated memories help Elora follow your day. Background thinking steps aside when you start talking.', example: '“What was I working on earlier?”' },
  { icon: 'mouse-pointer-2', tag: 'Optional · desktop', title: 'Turn a request into action.', body: 'Ask her to open an app, switch windows or type for you. Desktop control runs on your request; system and raw file operations still need approval.', example: '“Open Notepad and type hello.”' },
  { icon: 'calendar-days', tag: 'Time & reminders', title: 'Make room for real life.', body: 'Dates and reminders are calculated in your time zone. If the time is missing, she asks. Personal calendar and prayer-time features are optional.', example: '“Remind me in 20 minutes.”' },
  { icon: 'mail', tag: 'Optional · Google', title: 'Connect the work around you.', body: 'Bring Gmail, Calendar and Drive into the conversation after Google sign-in. Reads can run automatically; sending, creating and deleting require approval.', example: '“Any meetings on my calendar today?”' },
  { icon: 'activity', tag: 'Workspace', title: 'See what is happening.', body: 'A live boot monitor shows which services are starting, ready, disabled or failed. Use the HUD, command center or a lip-synced 3D avatar.', example: 'Chat · voice · observers · brain · tools' },
];
const requirements = [
  { label: 'Platform', value: 'Windows 10 / 11', icon: 'monitor' },
  { label: 'Reference GPU', value: '4 GB · GTX 1650 class', icon: 'cpu' },
  { label: 'Memory', value: '16 GB minimum', icon: 'memory-stick' },
  { label: 'Local models', value: 'Ollama', icon: 'hard-drive' },
];
const faqTeaser = FAQS.filter((f) => ['Does Elora work without the cloud?', 'What hardware does Elora need?', 'Is Elora always listening?', 'Can Elora connect to Google Workspace?'].includes(f.q));
---

<Base title={SITE.title} description={SITE.description}>
  <Hero />
  <section id="capabilities" class="bg-surface-container-lowest px-4 py-24 sm:px-6 md:py-28" aria-labelledby="capabilities-title">
    <div class="mx-auto max-w-6xl">
      <SectionHeader eyebrow="A companion for your actual day" id="capabilities-title">
        <Fragment slot="title">A conversation that can <span class="text-primary-container">go somewhere.</span></Fragment>
        From a quick reminder to the work on your screen, Elora brings voice, context and useful actions into one Windows workspace.
      </SectionHeader>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => (
          <article class="glass flex flex-col rounded-2xl p-6" data-reveal data-spotlight>
            <div class="flex items-center justify-between gap-3"><Icon name={item.icon} size={24} class="text-primary-container" /><span class="font-mono text-tele-sm uppercase text-on-surface-variant">{item.tag}</span></div>
            <h3 class="mt-6 font-display text-headline-sm font-semibold text-primary">{item.title}</h3>
            <p class="mt-3 flex-1 text-body-md text-on-surface-variant">{item.body}</p>
            <p class="mt-6 border-t border-white/10 pt-4 text-body-sm text-tertiary-fixed">{item.example}</p>
          </article>
        ))}
      </div>
      <p class="mt-8 text-center"><a class="inline-flex items-center gap-2 text-primary-container hover:underline" href="/capabilities/">Explore capabilities and their requirements <Icon name="arrow-right" size={18} /></a></p>
    </div>
  </section>
  <section id="modes" class="px-4 py-24 sm:px-6" aria-labelledby="modes-title">
    <div class="mx-auto max-w-6xl">
      <SectionHeader eyebrow="Choose what connects" id="modes-title">
        <Fragment slot="title">Local at the core.<br /><span class="text-primary-container">Connected when you choose.</span></Fragment>
        The background brain, vision, embeddings and memory stay on your PC. Choose separately whether speech recognition, chat and voice use GroqCloud.
      </SectionHeader>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <article class="glass rounded-2xl p-7" data-reveal>
          <div class="flex items-center gap-3 text-tertiary-fixed"><Icon name="laptop" size={26} /><span class="font-mono text-label-caps uppercase">Local · default</span></div>
          <h3 class="mt-5 font-display text-headline-md text-primary">Your PC does the thinking.</h3>
          <p class="mt-3 text-on-surface-variant">Use local chat through Ollama, local speech recognition and local voices. Once the required models are downloaded, these features can work offline.</p>
          <ul class="mt-6 space-y-3 text-body-sm text-on-surface"><li>✓ Conversations processed on your hardware</li><li>✓ SQLite and vector memory stored locally</li><li>✓ No cloud account needed for the local experience</li></ul>
        </article>
        <article class="glass rounded-2xl p-7 ring-1 ring-primary-container/20" data-reveal>
          <div class="flex items-center gap-3 text-primary-container"><Icon name="cloud" size={26} /><span class="font-mono text-label-caps uppercase">Hybrid · opt-in</span></div>
          <h3 class="mt-5 font-display text-headline-md text-primary">Add cloud where it helps.</h3>
          <p class="mt-3 text-on-surface-variant">Enable GroqCloud for speech, chat or voice independently. Failed cloud requests fall back to the configured local engine. Desktop control also needs hybrid mode and Groq.</p>
          <ul class="mt-6 space-y-3 text-body-sm text-on-surface"><li>↗ Selected audio or text leaves the device</li><li>↗ Google connections access your authorized account</li><li>✓ The background brain remains local</li></ul>
        </article>
      </div>
      <p class="mt-6 text-center text-body-sm text-on-surface-variant">Cloud chat may receive retrieved context; cloud voice receives text to speak. <a href="/privacy/#internet" class="text-primary-container underline underline-offset-4">See exactly what can leave your PC.</a></p>
    </div>
  </section>
  <CognitiveLoop />
  <section id="memory" class="bg-surface-container-lowest px-4 py-24 sm:px-6" aria-labelledby="memory-title">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <SectionHeader eyebrow="A little more continuity" tone="mint" align="left" id="memory-title">
        <Fragment slot="title">What matters today.<br />What changed since then.</Fragment>
        Working memory, searchable events, dated facts and semantic recall give Elora several ways to find context. Nightly consolidation and forgetting help keep that memory useful.
      </SectionHeader>
      <div class="glass rounded-2xl p-6 md:p-8" data-reveal>
        <p class="font-mono text-label-caps uppercase text-tertiary-fixed">Memory on your PC</p>
        <ol class="mt-6 space-y-5">
          <li class="border-b border-white/10 pb-4"><h3 class="font-display text-lg text-primary">01 / In the moment</h3><p class="mt-1 text-on-surface-variant">Working memory keeps current goals and recent context close.</p></li>
          <li class="border-b border-white/10 pb-4"><h3 class="font-display text-lg text-primary">02 / Across your day</h3><p class="mt-1 text-on-surface-variant">Search the local timeline and retrieve relevant past conversations.</p></li>
          <li><h3 class="font-display text-lg text-primary">03 / Over time</h3><p class="mt-1 text-on-surface-variant">Facts carry dates and memory blocks retain version history.</p></li>
        </ol>
        <p class="mt-6 text-body-sm text-on-surface-variant">Memory retrieval is still being improved. <a href="/how-it-works/#limitations" class="text-primary-container underline">Read the current limitations.</a></p>
      </div>
    </div>
  </section>
  <section id="privacy" class="px-4 py-24 sm:px-6" aria-labelledby="privacy-title">
    <div class="glass mx-auto grid max-w-6xl gap-10 rounded-3xl p-7 md:p-12 lg:grid-cols-2">
      <div><Icon name="shield-check" size={36} class="text-tertiary-fixed" /><h2 id="privacy-title" class="mt-6 font-display text-h2 font-bold text-primary">Useful actions.<br />Visible boundaries.</h2><p class="mt-5 text-body-lg text-on-surface-variant">Elora's tools have different permissions. You can see which actions need approval and which connections you have enabled.</p><a href="/privacy/" class="mt-7 inline-flex items-center gap-2 text-tertiary-fixed hover:underline">Read the privacy model <Icon name="arrow-right" size={18} /></a></div>
      <ul class="space-y-6 text-on-surface-variant">
        <li><h3 class="mb-1 font-display text-lg text-primary">You direct desktop control.</h3>The background brain cannot use the desktop agent. PowerShell, registry, closing programs and raw file operations wait for approval.</li>
        <li><h3 class="mb-1 font-display text-lg text-primary">Connected writes ask first.</h3>Sending an email, changing a calendar event or creating a Drive file requires visible approval in the HUD.</li>
        <li><h3 class="mb-1 font-display text-lg text-primary">Context is treated as untrusted.</h3>Screen text, email and tool results pass through policy protections. Privacy mode pauses perception.</li>
      </ul>
    </div>
  </section>
  <section id="requirements" class="bg-surface-container-lowest px-4 py-24 sm:px-6" aria-labelledby="requirements-title">
    <div class="mx-auto max-w-6xl">
      <SectionHeader eyebrow="Built for Windows" id="requirements-title"><Fragment slot="title">Start with the machine you have.</Fragment>Elora is tuned on a 4 GB GTX 1650. Model choice and optional features affect performance; 32–64 GB of RAM gives heavier workloads more room.</SectionHeader>
      <dl class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{requirements.map((item) => (<div class="glass rounded-xl p-5" data-reveal><dt class="flex items-center gap-2 text-body-sm text-on-surface-variant"><Icon name={item.icon} size={20} class="text-primary-container" />{item.label}</dt><dd class="mt-3 font-display text-lg text-primary">{item.value}</dd></div>))}</dl>
      <p class="mt-7 text-center text-on-surface-variant">Source setup uses Python 3.13 and Node.js for the HUD. <a href="/get-started/" class="text-primary-container underline underline-offset-4">Read the setup guide.</a></p>
    </div>
  </section>
  <section class="px-4 py-24 sm:px-6" aria-labelledby="faq-title"><div class="mx-auto max-w-3xl"><SectionHeader eyebrow="Good questions" id="faq-title"><Fragment slot="title">Know what you're bringing home.</Fragment></SectionHeader><div class="mt-10"><FaqList items={faqTeaser} /></div><p class="mt-8 text-center"><a href="/faq/" class="text-primary-container hover:underline">All questions about Elora →</a></p></div></section>
  <EarlyAccess />
</Base>
