---
import Icon from './Icon.astro';
---

<section class="bg-surface-container-lowest px-4 py-20 sm:px-6" aria-labelledby="cta-title">
  <div class="glass hud-corners mx-auto flex max-w-5xl flex-col items-center gap-6 rounded-[2rem] px-6 py-14 text-center md:py-16" data-reveal>
    <span class="eyebrow text-primary-container">Early access · Windows 10 &amp; 11</span>
    <h2 id="cta-title" class="font-display text-h2 font-bold text-primary">Be first <span class="text-primary-container text-glow">to meet her.</span></h2>
    <p class="max-w-xl text-body-lg text-on-surface-variant">One email when the first public build is ready. Nothing else.</p>
    <a href="/#early-access" class="btn-primary"><Icon name="sparkles" size={18} />Get early access</a>
  </div>
</section>
