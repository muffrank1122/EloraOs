---
import Icon from './Icon.astro';
---
<section class="bg-surface-container-lowest px-4 py-20 sm:px-6" aria-labelledby="cta-title">
  <div class="glass hud-corners mx-auto max-w-5xl rounded-3xl px-6 py-14 text-center" data-reveal>
    <span class="eyebrow text-primary-container">Windows · active development</span>
    <h2 id="cta-title" class="mt-5 font-display text-h2 font-bold text-primary">Get to know your next companion.</h2>
    <p class="mx-auto mt-4 max-w-xl text-body-lg text-on-surface-variant">See the requirements, source setup and optional connections.</p>
    <a href="/get-started/" class="btn-primary mt-7">Get started <Icon name="arrow-right" size={18} /></a>
  </div>
</section>
