---
import Icon from '../Icon.astro';
import { SITE } from '../../data/site';
---
<section id="early-access" class="bg-surface-container-lowest px-4 py-24 sm:px-6" aria-labelledby="access-title">
  <div class="glass hud-corners mx-auto max-w-6xl rounded-3xl p-8 text-center md:p-16" data-reveal>
    <span class="eyebrow text-tertiary-fixed">Windows · active development</span>
    <h2 id="access-title" class="mt-6 font-display text-h2 font-bold text-primary">Make room for Elora.</h2>
    <p class="mx-auto mt-5 max-w-2xl text-body-lg text-on-surface-variant">Explore the setup, choose your local and connected features, and see what is ready today. A public installer is not available from this website yet.</p>
    <a href="/get-started/" class="btn-primary mt-8">Explore setup &amp; availability <Icon name="arrow-right" size={18} /></a>
    <p class="mt-7 font-mono text-tele-sm text-on-surface-variant">Product information reviewed {SITE.contentUpdatedLabel}</p>
  </div>
</section>
