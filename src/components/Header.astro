---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  data-header
  class="group/header fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300 data-[scrolled]:border-primary-container/10 data-[scrolled]:bg-surface-container-lowest/80 data-[scrolled]:shadow-[0_8px_30px_rgb(0_0_0/0.45)] data-[scrolled]:backdrop-blur-xl"
  style="view-transition-name: site-header"
>
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 md:h-20">
    <a href="/" class="flex min-h-11 items-center gap-2.5 text-primary-container">
      <Logo size={28} />
      <span class="font-display text-[1.35rem] font-semibold uppercase tracking-[0.28em] text-primary">Elora</span>
      <span class="rounded-full bg-surface-container-high px-1.5 py-0.5 font-mono text-label-caps text-on-surface-variant">OS</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 rounded-full bg-surface-container-low/70 p-1 ring-1 ring-white/5 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="rounded-full px-4 py-1.5 text-body-sm text-on-surface-variant transition-colors hover:bg-surface-container-high hover:text-on-surface aria-[current=page]:bg-surface-container-high aria-[current=page]:text-primary"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <span class="hidden items-center gap-2 rounded-full bg-surface-container-low/80 px-3 py-1.5 font-mono text-tele-sm text-on-surface ring-1 ring-tertiary-fixed/20 md:flex">
        <span class="led text-tertiary-fixed"></span>
        Runs on-device
      </span>
      <a href="/#early-access" class="hidden min-h-10 items-center rounded-xl bg-primary-container px-4 font-mono text-tele-md font-bold uppercase tracking-wider text-on-primary-fixed shadow-[0_0_20px_rgb(0_242_254/0.35)] transition-shadow hover:shadow-[0_0_32px_rgb(0_242_254/0.6)] sm:inline-flex">
        Get early access
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-xl text-on-surface ring-1 ring-white/10 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" size={22} class="menu-open" />
        <Icon name="x" size={22} class="menu-close hidden" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="hidden border-t border-primary-container/10 bg-surface-container-lowest/95 px-4 pb-6 pt-2 backdrop-blur-xl lg:hidden"
    data-mobile-nav
  >
    <ul class="mx-auto flex max-w-7xl flex-col">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="flex min-h-12 items-center justify-between border-b border-white/5 font-display text-lg text-on-surface aria-[current=page]:text-primary-container"
            >
              {item.label}
              <Icon name="arrow-right" size={18} class="text-outline" />
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/#early-access" class="btn-primary mt-5 w-full">Get early access</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    panel.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
