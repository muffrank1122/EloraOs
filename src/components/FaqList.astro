---
import Icon from './Icon.astro';
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  /** Open the first answer by default. */
  openFirst?: boolean;
  /** Question heading level: h2 when the list sits directly under the page h1. */
  headingLevel?: 'h2' | 'h3';
}
const { items, openFirst = false, headingLevel: Q = 'h3' } = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    items.map((item, i) => (
      <details class="glass group rounded-2xl open:ring-1 open:ring-primary-container/25" open={openFirst && i === 0} data-reveal>
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 md:px-6 [&::-webkit-details-marker]:hidden">
          <Q class="font-display text-[1.05rem] font-medium text-on-surface group-open:text-primary md:text-headline-sm">{item.q}</Q>
          <Icon name="chevron-down" size={20} class="shrink-0 text-primary-container transition-transform duration-300 group-open:rotate-180" />
        </summary>
        <p class="px-5 pb-5 text-body-md text-on-surface-variant md:px-6 md:pb-6 md:text-[1rem] md:leading-7">{item.a}</p>
      </details>
    ))
  }
</div>
